# Anthropic API key. NEVER use NEXT_PUBLIC_ for secrets.
ANTHROPIC_API_KEY=
# Defaults to tested model names; override if your account needs newer/other models.
AI_FAST_MODEL=claude-haiku-4-5-20251001
AI_MAIN_MODEL=claude-sonnet-4-5-20250929
# Supabase: create dedicated project; service-role key stays server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional safe-mode: when unset, generated builds are disabled in production.
ENABLE_PUBLIC_BUILDS=false
MAX_DAILY_BUILDS=20
MAX_IP_DAILY_BUILDS=3
MAX_CONCURRENT_BUILDS=2
