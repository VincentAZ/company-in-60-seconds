# Secrets stay server-side. Never use NEXT_PUBLIC_ for these values.
ANTHROPIC_API_KEY=
AI_FAST_MODEL=claude-haiku-4-5-20251001
AI_MAIN_MODEL=claude-sonnet-4-6
# Dedicated Supabase project, with migrations applied.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Both flags, all secrets, and enabled DB budget are required in every environment.
# Set VERIFIED only after a real API run and production controls pass verification.
ENABLE_PUBLIC_BUILDS=false
GENERATION_VERIFIED=false
# Generate independent random values, at least 32 characters each.
IP_HASH_SALT=
BUILD_ACCESS_SECRET=
# Optional canonical origin for share metadata, no trailing slash.
SITE_URL=
